# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# NOTE: prerendered/ is intentionally NOT ignored. It holds the committed static
# HTML that Vercel serves, because the build image has no Chromium to generate it.
# Regenerate with `npm run prerender` after content changes, then commit.

# Vercel
.vercel

# Environment
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test / cache
coverage/
.cache/
*.tsbuildinfo
